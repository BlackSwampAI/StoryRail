STORYRAIL_DATABASE_URL=
# The key every stored credential is encrypted under, as 32 random bytes in base64:
# `openssl rand -base64 32`. It cannot live in the database it protects, and it is not
# recoverable — losing it means every credential has to be entered again.
STORYRAIL_CREDENTIAL_KEY=
# The Site this installation serves. Leave unset unless a second Site has been created.
STORYRAIL_SITE_ID=
STORYRAIL_OPERATOR_ID=
